generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TipStatus {
  pending
  success
  failed
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  slug           String   @unique
  bio            String?
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  tips           Tip[]
}

model Tip {
  id          String    @id @default(cuid())
  creatorId   String
  creator     User      @relation(fields: [creatorId], references: [id])
  tipperName  String?
  tipperEmail String
  amount      Int
  message     String?
  txRef       String    @unique
  flwTxId     String?   @unique
  status      TipStatus @default(pending)
  createdAt   DateTime  @default(now())
}
